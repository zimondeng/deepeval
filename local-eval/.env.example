# Copy to local-eval/.env. That file is gitignored. Do not commit a real key.
DEEPEVAL_EVAL_MODE=system_one
JEV_API_KEY=
JEV_BASE_URL=https://emrank.tech
JEV_MODEL=typesafe/jev-1.14.0

# Container egress on this machine goes through the host proxy.
# EVAL_HTTP_PROXY=http://host.docker.internal:10808
# EVAL_HTTPS_PROXY=http://host.docker.internal:10808
# Leave TARGET_BASE_URL empty to score the fixture answer in datasets/.
# A service on the Windows host is host.docker.internal, not localhost.
# TARGET_BASE_URL=http://host.docker.internal:8080
TARGET_BASE_URL=
TARGET_PATH=/chat
